{
  "name": "rekiya",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "import:cse": "pnpm --filter @rekiya/crawler import:cse",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "crawl": "pnpm --filter @rekiya/crawler crawl",
    "discover": "pnpm --filter @rekiya/crawler discover",
    "validate:data": "pnpm --filter @rekiya/crawler validate:data",
    "build": "pnpm --filter @rekiya/web build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "globals": "^17.12.0",
    "prettier": "^3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8"
  }
}
